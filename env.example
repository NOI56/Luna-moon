# ============================================
# Luna AI v10 - Environment Variables
# ============================================
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าตามที่ต้องการ

# ============================================
# Server Configuration
# ============================================
PORT=8787

# ============================================
# AI / LLM Configuration
# ============================================
# ใช้ OPENAI_KEY หรือ OPENROUTER_KEY (อย่างใดอย่างหนึ่ง)
OPENAI_KEY=your_openai_api_key_here
# หรือ
OPENROUTER_KEY=your_openrouter_api_key_here

# Model Selection (Auto-select based on question complexity)
# คำถามง่าย → ใช้ SIMPLE_MODEL (default: gpt-4o-mini)
# คำถามยาก → ใช้ COMPLEX_MODEL (default: anthropic/claude-3-opus - แนะนำ!)
# 
# หมายเหตุ: GPT-5 ยังไม่มีใน OpenAI API และ OpenRouter (ณ วันที่เขียน)
# ถ้า GPT-5 เปิดตัวแล้ว สามารถเปลี่ยน COMPLEX_MODEL=gpt-5 ได้เลย
#
# Model ที่รองรับ (OpenAI API):
#   - gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
#
# Model ที่รองรับ (OpenRouter - ใช้ OPENROUTER_KEY):
#   - anthropic/claude-3-opus (แนะนำ - แข็งแกร่งที่สุด!)
#   - openai/gpt-4o (เร็วและดี)
#   - anthropic/claude-3-sonnet (ดีและเร็วกว่า Opus)
#   - openai/gpt-4-turbo
#   - google/gemini-pro-1.5
#   - meta-llama/llama-3-70b-instruct
#
# Claude-3-Opus vs GPT-4o:
#   - Claude-3-Opus: ดีกว่าในการวิเคราะห์, reasoning, และงานซับซ้อน
#   - GPT-4o: เร็วกว่าและประหยัดกว่า
#   - สำหรับคำถามยาก: แนะนำ Claude-3-Opus (ประสิทธิภาพสูงกว่า)
#
# ถ้าใช้ OpenAI API (OPENAI_KEY) → ใช้ gpt-4o
# ถ้าใช้ OpenRouter (OPENROUTER_KEY) → ใช้ anthropic/claude-3-opus
SIMPLE_MODEL=gpt-4o-mini
COMPLEX_MODEL=anthropic/claude-3-opus
FALLBACK_MODEL=gpt-4o-mini

# ============================================
# VTube Studio Configuration
# ============================================
# เปิดใช้งาน VTube Studio integration
VTS_ENABLED=true

# VTube Studio connection (default: 127.0.0.1:8001)
VTS_HOST=127.0.0.1
VTS_PORT=8001

# Authentication Token (ขอจาก scripts/vts/vts-auth.cjs)
# หลังจากรัน node scripts/vts/vts-auth.cjs แล้วคัดลอก token มาใส่ตรงนี้
VTS_AUTH_TOKEN=

# ============================================
# ElevenLabs TTS Configuration
# ============================================
# ElevenLabs API Key
ELEVEN_KEY=your_elevenlabs_api_key_here

# Voice IDs (หาได้จาก ElevenLabs dashboard)
ELEVEN_VOICE_NORMAL=21m00Tcm4TlvDq8ikWAM
ELEVEN_VOICE_SOFT=21m00Tcm4TlvDq8ikWAM
ELEVEN_VOICE_PASSION=21m00Tcm4TlvDq8ikWAM

# เปิด/ปิด TTS (true/false)
TTS_ENABLED=true

# ============================================
# Rate Limiting (Optional)
# ============================================
# จำนวน request สูงสุดต่อ user ต่อนาที (default: 30)
RATE_LIMIT_MAX=30

# ============================================
# Logging (Optional)
# ============================================
# เปิดใช้งาน enhanced logging (true/false)
ENHANCED_LOGGING=false

# เปิดใช้งาน debug mode (แสดง stack trace)
DEBUG=false

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, verbose, debug, silly
# Default: info
LOG_LEVEL=info

# Enable console logging (true/false)
# Default: true in development, false in production
LOG_CONSOLE=true

# Enable verbose logging (show metadata in console)
# Default: false
LOG_VERBOSE=false

# ============================================
# CORS Configuration (Optional)
# ============================================
# กำหนด allowed origins (คั่นด้วย comma) หรือ "*" สำหรับ allow all
# ตัวอย่าง: CORS_ORIGINS=http://localhost:3000,https://example.com
# หรือ: CORS_ORIGINS=*
CORS_ORIGINS=*

# Security: CSRF Protection (Optional)
# ============================================
# ตั้งเป็น 'true' เพื่อเปิดใช้งาน CSRF protection สำหรับ POST/PUT/DELETE requests
# Default: true (เปิดใช้งานเพื่อความปลอดภัย)
# เมื่อเปิดใช้งาน frontend ต้อง fetch CSRF token จาก /api/csrf-token
ENABLE_CSRF=true

# ============================================
# Admin Configuration (Optional)
# ============================================
# Secret key สำหรับ admin endpoints (GET /luna/admin/*)
# ต้องส่ง header: x-admin-secret หรือ query: ?secret=...
ADMIN_SECRET=

# ============================================
# Solana Configuration (Optional)
# ============================================
# สำหรับ Solana wallet watcher
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LUNA_WALLET=your_solana_wallet_address_here

# ============================================
# Token Analysis / IP Detection (Optional)
# ============================================
# Axiom API Key สำหรับดึง IP address ของ wallet holders
# หมายเหตุ: Axiom API อาจต้องมี API key หรืออาจไม่เปิดให้ใช้ public API
# ถ้าไม่มี API key ระบบจะใช้ transaction pattern analysis แทน
AXIOM_API_KEY=your_axiom_api_key_here

# ============================================
# Luna Token Configuration
# ============================================
# Token Mint Address จาก Pump.fun (จำเป็นสำหรับระบบเก็บค่าธรรมเนียม)
# วิธีได้: สร้าง token บน https://pump.fun แล้วคัดลอก mint address มาใส่
# ระบบจะใช้ mint address นี้เพื่อดึงราคา Luna token จาก DexScreener API
# ตัวอย่าง: LUNA_TOKEN_MINT=CbB4ivri6wLfqx4NwrWY3ArD7mXv1e91HeYeq3KBpump
LUNA_TOKEN_MINT=your_token_mint_address_from_pumpfun_here

# Buy Link (pump.fun or DEX)
# ลิงก์สำหรับซื้อ token (ใช้สำหรับปุ่ม "Buy 1coin")
# ตัวอย่าง: LUNA_BUY_LINK=https://pump.fun/CbB4ivri6wLfqx4NwrWY3ArD7mXv1e91HeYeq3KBpump
# หรือ: LUNA_BUY_LINK=https://dexscreener.com/solana/8wwcnqdzjcy5pt7akhupafknv2txca9sq6ybkgzlbvdt
LUNA_BUY_LINK=https://pump.fun/your_token_mint_address_from_pumpfun_here

# X/Twitter Community Link
# ลิงก์สำหรับชุมชน X/Twitter (ใช้สำหรับปุ่ม "Join Community")
# ตัวอย่าง: LUNA_X_LINK=https://x.com/elonmuskTN
LUNA_X_LINK=https://x.com/your_community

# Luna to SOL Conversion Rate
# ตัวอย่าง: ถ้า 10000 Luna = 0.9 SOL → LUNA_TO_SOL_RATE=0.00009
# ค่า default: 0.00009 (1 Luna = 0.00009 SOL)
LUNA_TO_SOL_RATE=0.00009

# ============================================
# Betting Fee Collection Configuration
# ============================================
# Wallet Address สำหรับรับค่าธรรมเนียมจากการเดิมพัน (Optional - สำหรับบันทึกข้อมูล)
# 
# ⚠️ หมายเหตุสำคัญ:
# - ระบบจะคำนวณและบันทึกค่าธรรมเนียม 1% ในรูปแบบ SOL
# - ค่าธรรมเนียมจะถูกบันทึกไว้ใน memory (ไม่ส่งไปที่ wallet อัตโนมัติ)
# - ใช้ wallet address นี้เพื่อบันทึกว่าควรส่งค่าธรรมเนียมไปที่ไหน
# - การส่ง SOL จริงๆ ต้องใช้ private key ซึ่งไม่ควรเก็บใน server
# - ดูค่าธรรมเนียมที่เก็บได้: GET /luna/rps/betting/fees
# 
# ตัวอย่าง: BETTING_FEE_WALLET=YourSolanaWalletAddressHere
BETTING_FEE_WALLET=your_fee_wallet_address_here

# หมายเหตุเกี่ยวกับระบบเก็บค่าธรรมเนียม:
# - ระบบจะดึงราคา Luna token จาก Jupiter API อัตโนมัติ
# - ค่าธรรมเนียม 1% จะคำนวณจากราคา Luna ใน SOL
# - ตัวอย่าง: ถ้าเดิมพัน 10000 Luna และราคา = 0.9 SOL → ค่าธรรมเนียม = 0.009 SOL
# - ระบบจะบันทึกค่าธรรมเนียมของแต่ละ wallet ไว้ใน memory
# - ดูค่าธรรมเนียมที่เก็บได้: GET /luna/rps/betting/fees
# - ดูราคา Luna ปัจจุบัน: GET /luna/rps/betting/price
# 
# 💡 วิธีส่งค่าธรรมเนียมไปที่ wallet:
#   1. ดูค่าธรรมเนียมทั้งหมด: GET /luna/rps/betting/fees
#   2. ใช้ Solana wallet (Phantom, Solflare) ส่ง SOL ไปที่ BETTING_FEE_WALLET
#   3. หรือใช้ Solana CLI/SDK เพื่อส่งค่าธรรมเนียมที่สะสมไว้

# ============================================
# Reward Distribution Configuration
# ============================================
# 
# 🎁 ระบบแจกรางวัล (Reward Distribution System)
# 
# รางวัลจะถูกแจกตามอันดับใน Leaderboard:
#   - อันดับ 1 (Top Winner): 20% ของรางวัลทั้งหมด
#   - อันดับ 2: 10% ของรางวัลทั้งหมด
#   - อันดับ 3: 5% ของรางวัลทั้งหมด
#   - อันดับ 4: 3% ของรางวัลทั้งหมด
#   - อันดับ 5: 2% ของรางวัลทั้งหมด
#   - ที่เหลือ 60% → ส่งไปที่ REWARD_DISTRIBUTION_WALLET
# 
# ตัวอย่าง: ถ้ามีรางวัล 100 SOL
#   - อันดับ 1 ได้ 20 SOL
#   - อันดับ 2 ได้ 10 SOL
#   - อันดับ 3 ได้ 5 SOL
#   - อันดับ 4 ได้ 3 SOL
#   - อันดับ 5 ได้ 2 SOL
#   - REWARD_DISTRIBUTION_WALLET ได้ 60 SOL
# 
# ============================================
# REWARD_DISTRIBUTION_WALLET
# ============================================
# Wallet Address สำหรับรับ 60% ของรางวัลที่เหลือ
# 
# ⚠️ หมายเหตุ:
# - Wallet นี้จะได้รับ 60% ของรางวัลทั้งหมดหลังจากแจกให้ top 5 แล้ว
# - ใช้สำหรับเก็บรางวัลส่วนกลาง หรือส่งต่อให้ทีม/โปรเจค
# - ต้องเป็น Solana wallet address ที่ถูกต้อง (base58 format)
# 
# ตัวอย่าง: REWARD_DISTRIBUTION_WALLET=YourSolanaWalletAddressHere
REWARD_DISTRIBUTION_WALLET=ofLr5MWJVjZNzR9xSomLLKUaEvVsdQG79b21W12t8Sp

# ============================================
# REWARD_SENDER_PRIVATE_KEY
# ============================================
# Private Key สำหรับส่ง SOL อัตโนมัติ (⚠️ เก็บเป็นความลับอย่างเคร่งครัด!)
# 
# 🔐 ความปลอดภัย:
# - Private key นี้จะใช้สำหรับส่ง SOL ไปยังผู้ชนะและ distribution wallet
# - ต้องเก็บเป็นความลับ! อย่าแชร์หรือ commit ลง Git
# - ควรใช้ wallet แยกต่างหากสำหรับส่งรางวัล (ไม่ใช่ wallet หลัก)
# - Wallet นี้ต้องมี SOL เพียงพอสำหรับ:
#   * ส่งรางวัลให้ผู้ชนะ
#   * Transaction fees (ประมาณ 0.000005 SOL ต่อ transaction)
# 
# 📝 รูปแบบ:
# - ต้องเป็น base58 encoded private key
# - วิธีได้ private key จาก Phantom wallet:
#   1. เปิด Phantom wallet
#   2. Settings → Security & Privacy → Export Private Key
#   3. คัดลอก private key (จะได้ array ของตัวเลข)
#   4. แปลงเป็น base58 (ใช้ bs58.encode())
# 
# ⚠️ คำเตือน:
# - ถ้าไม่ใส่ private key → ระบบจะไม่สามารถส่ง SOL อัตโนมัติได้
# - ต้องเรียก API POST /luna/rps/rewards/distribute เพื่อแจกรางวัล
# - ระบบจะแสดง error ถ้า private key ไม่ถูกต้องหรือ wallet ไม่มี SOL
# 
# ตัวอย่าง: REWARD_SENDER_PRIVATE_KEY=your_base58_private_key_here
REWARD_SENDER_PRIVATE_KEY=your_private_key_here

# ============================================
# DEPOSIT_ESCROW_WALLET
# ============================================
# Wallet Address สำหรับเก็บ Luna ที่ผู้ใช้ฝากไว้
# 
# ⚠️ หมายเหตุ:
# - Wallet นี้จะเก็บ Luna tokens ที่ผู้ใช้ฝากไว้
# - ใช้สำหรับส่ง Luna กลับให้ผู้ใช้เมื่อถอน
# - ต้องมี SOL เพียงพอสำหรับ transaction fee (ประมาณ 0.000005 SOL ต่อ transaction)
# - ต้องเป็น Solana wallet address ที่ถูกต้อง (base58 format)
# 
# ตัวอย่าง: DEPOSIT_ESCROW_WALLET=YourSolanaWalletAddressHere
DEPOSIT_ESCROW_WALLET=FLMbMZXn6d5mWf6EWFAeVFcV4w7ioZ6PZAWSp8wxK4RU

# ============================================
# DEPOSIT_ESCROW_PRIVATE_KEY
# ============================================
# Private Key สำหรับส่ง Luna tokens กลับให้ผู้ใช้เมื่อถอน (⚠️ เก็บเป็นความลับอย่างเคร่งครัด!)
# 
# 🔐 ความปลอดภัย:
# - Private key นี้จะใช้สำหรับส่ง Luna tokens กลับให้ผู้ใช้เมื่อถอน
# - ต้องเก็บเป็นความลับ! อย่าแชร์หรือ commit ลง Git
# - Wallet นี้ต้องมี:
#   * Luna tokens ที่ผู้ใช้ฝากไว้
#   * SOL เพียงพอสำหรับ transaction fee (ประมาณ 0.000005 SOL ต่อ transaction)
# 
# 📝 รูปแบบ:
# - ต้องเป็น base58 encoded private key
# - ต้องตรงกับ DEPOSIT_ESCROW_WALLET
# 
# ⚠️ คำเตือน:
# - ถ้าไม่ใส่ private key → ระบบจะไม่สามารถส่ง Luna tokens กลับได้
# - ระบบจะแสดง error ถ้า private key ไม่ถูกต้องหรือ wallet ไม่มี Luna/SOL
# 
# ตัวอย่าง: DEPOSIT_ESCROW_PRIVATE_KEY=your_base58_private_key_here
DEPOSIT_ESCROW_PRIVATE_KEY=your_base58_private_key_here

# ============================================
# BETTING_ESCROW_WALLET (Stake Locking)
# ============================================
# Wallet แยกสำหรับเก็บเงินเดิมพัน (ไม่ใช่ระบบ deposit ลดค่าธรรมเนียม)
BETTING_ESCROW_WALLET=AyFeetrTfopNNqVDHHaoutvNxUJihogPgT7b9e6YhrU7
BETTING_ESCROW_PRIVATE_KEY=65kv5Hb3a9r5Hg2YLSb6HPL6QLnmqafYhFT2zhNygibuaEY5cYJcBTz41iKHbrafRZYjUH9xb2ydhashPmMqTCLo

# ============================================
# DEPOSIT_BURN_WALLET
# ============================================
# Wallet สำหรับรับค่าธรรมเนียมที่ถูกเผา (3% ของยอดฝากตามค่าเริ่มต้น)
# - ถ้าไม่ตั้งค่า ระบบจะใช้ค่าเริ่มต้น: 1nc1nerator11111111111111111111111111111111 (incinerator)
# - ควรเป็นกระเป๋าที่คุณไม่ใช้ private key แล้ว (burn address)
# - ต้องเป็น Solana address ที่ถูกต้อง (base58)
DEPOSIT_BURN_WALLET=1nc1nerator11111111111111111111111111111111

# ============================================
# Deposit Dynamic Pricing (Optional)
# ============================================
# ระบบฝาก Luna จะปรับขั้นต่ำตามราคาตลาดอัตโนมัติ
# ค่าเหล่านี้ใช้กำหนด target เป็น USD และขอบเขตบน/ล่างของ requirement
# ค่าเริ่มต้น:
#   - DEPOSIT_BASE_MIN_USD = 10   → ต้องถือ Luna มูลค่าประมาณ $10
#   - DEPOSIT_MIN_USD_FLOOR = 5   → ไม่ต่ำกว่า $5
#   - DEPOSIT_MIN_USD_CAP = 30    → ไม่สูงกว่า $30
#   - DEPOSIT_DYNAMIC_CACHE_MS = 5000 (5 วินาที) → ระยะเวลา cache ของราคา (default: 5 seconds)
DEPOSIT_BASE_MIN_USD=10
DEPOSIT_MIN_USD_FLOOR=5
DEPOSIT_MIN_USD_CAP=30
DEPOSIT_DYNAMIC_CACHE_MS=5000

# ============================================
# วิธีใช้งานระบบแจกรางวัล:
# ============================================
# 1. ดูสถานะรางวัล: GET /luna/rps/rewards/pool
#    - ดูรางวัลที่สะสมไว้
#    - ดูแผนการแจกรางวัล (ใครจะได้เท่าไหร่)
# 
# 2. แจกรางวัล: POST /luna/rps/rewards/distribute
#    - ระบบจะส่ง SOL ไปยัง top 5 และ distribution wallet อัตโนมัติ
#    - ต้องมี REWARD_SENDER_PRIVATE_KEY ตั้งค่าไว้
#    - Wallet sender ต้องมี SOL เพียงพอ
# 
# 3. ดู Leaderboard: GET /luna/rps/leaderboard
#    - ดูอันดับผู้เล่น
#    - ดูสถิติการชนะ/แพ้
#    - ดูจำนวน SOL ที่ชนะ

# ============================================
# Cost Saving Features (Optional)
# ============================================
# ปิดฟีเจอร์ที่เปลือง API calls เพื่อประหยัดค่าใช้จ่าย
# 
# Idle Monologue: Luna พูดเองตอนเงียบ (ทุก 60 วินาที)
# - ตั้งเป็น false เพื่อปิด (ประหยัด token มาก!)
IDLE_MONOLOGUE_ENABLED=false

# Ambient Murmur: Luna พึมพำเองเป็นระยะ (ทุก 3-5 นาที)
# - ตั้งเป็น false เพื่อปิด (ประหยัด token มาก!)
AMBIENT_MURMUR_ENABLED=false

# ============================================
# Backup Configuration (Optional)
# ============================================
# เปิดใช้งาน auto-backup (true/false)
# Default: true
AUTO_BACKUP_ENABLED=true

# ระยะเวลาระหว่าง backup (milliseconds)
# Default: 3600000 (1 hour)
# ตัวอย่าง: 1800000 = 30 นาที, 86400000 = 24 ชั่วโมง
BACKUP_INTERVAL=3600000

# จำนวน backup ที่เก็บไว้ (ลบ backup เก่าอัตโนมัติ)
# Default: 10
MAX_BACKUPS=10

# ============================================
# Notes:
# ============================================
# 1. VTS_AUTH_TOKEN: รัน node scripts/vts/vts-auth.cjs เพื่อขอ token
# 2. ELEVEN_KEY: ต้องมี API key จาก ElevenLabs
# 3. OPENAI_KEY หรือ OPENROUTER_KEY: ต้องมีอย่างใดอย่างหนึ่ง
# 4. ดูคู่มือ VTS_SETUP_GUIDE.md สำหรับการตั้งค่า VTube Studio
# 5. IDLE_MONOLOGUE_ENABLED และ AMBIENT_MURMUR_ENABLED: ตั้งเป็น false เพื่อประหยัด API costs

# ============================================
